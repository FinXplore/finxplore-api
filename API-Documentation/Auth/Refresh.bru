meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "dialing_code": "+1",
    "mobile_number": "1234567890",
    "refresh_token": "{{refresh_token}}"
  }
}

script:post-response {
  bru.setEnvVar("access_token", res.body.access_token);
}
